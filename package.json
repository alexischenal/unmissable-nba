{
  "name": "unmissable",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Last night's NBA games, ranked without spoilers.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "fetch": "node --experimental-strip-types --no-warnings scripts/fetch-night.ts",
    "season-stats": "node --experimental-strip-types --no-warnings scripts/season-stats.ts",
    "check-window": "node --experimental-strip-types --no-warnings scripts/check-window.ts",
    "explain": "node --experimental-strip-types --no-warnings scripts/explain.ts",
    "fetch:fixture": "node --experimental-strip-types --no-warnings scripts/fetch-night.ts --fixture",
    "test": "node --experimental-strip-types --no-warnings --test scripts/nba/plan.test.ts scripts/nba/order.test.ts scripts/nba/schedule-cache.test.ts scripts/nba/adapter.test.ts src/lib/colors.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.2.0",
    "@fontsource/big-shoulders-display": "^5.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sass-embedded": "^1.105.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.0"
  }
}
